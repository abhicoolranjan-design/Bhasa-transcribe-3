# --- Pick ONE provider -------------------------------------------------
# OpenAI Whisper / gpt-4o-transcribe
STT_BASE_URL=https://api.openai.com/v1
STT_API_KEY=sk-...
STT_MODEL=whisper-1

# Groq (much faster + cheaper, whisper-large-v3 / -turbo)
# STT_BASE_URL=https://api.groq.com/openai/v1
# STT_API_KEY=gsk_...
# STT_MODEL=whisper-large-v3

# --- Optional ----------------------------------------------------------
PORT=3000
MAX_UPLOAD_MB=25
# Comma-separated allowed origins if the frontend is hosted elsewhere
# CORS_ORIGINS=https://your-domain.com
# Optional shared secret the app must send in the x-app-token header
# APP_TOKEN=change-me
